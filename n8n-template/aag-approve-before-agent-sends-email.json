            "index": 0
          }
        ]
      ]
    },
    "Send Email (only if approved)": {
      "main": [
        [
          {
            "node": "Audit Log \u2014 Decision",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Audit Log \u2014 Decision": {
      "main": [
        [
          {
            "node": "Respond to Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false,
    "notes": "AAG wedge template by Ingenious AI (MIT). Gate: no email leaves until a human decision resumes the Wait node. Pair with the AAG Slack approval app for Approve/Deny buttons."
